# MinTranslate build-time configuration
#
# Copy to `.env.local` and adjust. Anything committed here must stay
# non-sensitive: every variable below is public by construction.
#
# WARNING — variables prefixed with `VITE_` are inlined into the browser
# bundle. They are readable by anyone who loads the application. NEVER put an
# API key, token, password or database connection string in a `VITE_` variable.
# MinTranslate is BYOK: the user supplies their own model key at runtime and it
# stays in the browser. See docs/deployment.md.

# Deployment base path.
# Use `/` for a root deployment, or a sub-path such as `/mintranslate/` when the
# application is mounted below the site root. A missing leading slash or a
# trailing slash is tolerated and normalized. Defaults to `/`.
VITE_BASE_PATH=/

# Google Analytics 4 measurement ID (`G-XXXXXXXXXX`).
# Leave empty to ship no analytics at all — this is the default and the
# required setting for an intranet deployment. When empty, the build contains
# no reference to any analytics endpoint.
# When set, it takes precedence over a measurement ID entered in settings.
VITE_GA_MEASUREMENT_ID=

# Analytics master switch. Set to `false` to disable analytics for this build
# entirely, regardless of any measurement ID above or entered at runtime.
# This is a build-time guarantee, not a user-facing preference: it is the
# setting an intranet deployment uses so a misconfiguration cannot make the
# application send data to a public endpoint. Defaults to `true`.
VITE_GA_ENABLED=true
