{
  "name": "MinTranslate",
  "short_name": "MinTranslate",
  "description": "A self-hosted AI translation workbench. Bring your own model endpoint; text, images, documents and webpages stay under your control.",
  "lang": "zh-CN",
  "dir": "auto",
  "start_url": "./?op=translate",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
